# ========================================================
# CHAAT & CHILL CAFÉ — ENVIRONMENT CONFIGURATION
# ========================================================

# Persistent Managed Database (MongoDB Atlas or Self-hosted MongoDB)
# Example MongoDB Atlas URI:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/chaatandchill?retryWrites=true&w=majority
#
# Example Local MongoDB URI:
# MONGODB_URI=mongodb://localhost:27017/chaatandchill
MONGODB_URI=

# Administrator Portal Authentication Credentials
# (Change in production to your secure master credentials)
ADMIN_NAME=Mohan
ADMIN_EMAIL=admin@cafe.com
ADMIN_PASSWORD=admin@123
ADMIN_PIN=1234

# Secret key for signing secure tamper-proof JWT admin sessions
# (Generate a strong 32+ character random string for production)
JWT_SECRET=chaat-and-chill-super-secret-jwt-key-2026-production-ready

# Next.js App URL (Optional, defaults to localhost in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
